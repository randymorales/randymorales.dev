{
  "name": "randymorales.dev",
  "version": "0.1.1",
  "private": true,
  "homepage": "https://randymorales.dev",
  "scripts": {
    "cache-posts": "node lib/cache.mjs",
    "format": "prettier --write '*.js' 'components/*.js' 'i18n/*.js' 'lib/*.js' 'pages/*.js' 'pages/blog/*.js' 'pages/tags/*.js'",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.0.1",
    "@mdx-js/react": "^3.0.1",
    "@next/mdx": "^16.1.1",
    "@tailwindcss/typography": "^0.5.15",
    "autoprefixer": "^10.4.20",
    "date-fns": "^2.16.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.439.0",
    "next": "^16.1.1",
    "prismjs": "^1.24.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-slug": "^6.0.0",
    "tailwindcss": "^3.4.10"
  },
  "devDependencies": {
    "husky": "^4.2.5",
    "prettier": "2.2.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run cache-posts && git add cache/data.js"
    }
  }
}
